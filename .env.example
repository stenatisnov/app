# Application ---------------------------------------------------------------
# Public URL of the app (no trailing slash). Used in emails, guest links,
# the login QR code, and to decide whether cookies should be "secure".
APP_URL=http://localhost:3000

# Session cookie signing secret (hand-rolled cookie session, not Auth.js —
# see src/lib/session.server.ts). Generate with: openssl rand -hex 32
AUTH_SECRET=

PORT=3000

# Database (PostgreSQL) ----------------------------------------------------
# Local development: `docker compose up` starts a local Postgres alongside
# the app (see docker-compose.yml). In production on Railway, attach a
# Postgres plugin to this service instead — Railway injects DATABASE_URL
# into the app service automatically, so nothing needs setting there.
DATABASE_URL=postgresql://stena:stena@localhost:5432/stena_letnak

# Bootstrap admin -----------------------------------------------------------
# Created (or re-synced) on every start if both are set.
ADMIN_EMAIL=admin@stenaletnak.cz
ADMIN_PASS=change-me

# Google OAuth (optional) --------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP / email (optional) --------------------------------------------------
# Without SMTP_HOST, mail sending is skipped and logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Stěna Letňák Tišnov <noreply@stenaletnak.cz>"

# GoPay (optional) ----------------------------------------------------------
# Environment variables take precedence over the values stored in
# Admin -> Settings.
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_SANDBOX=true
