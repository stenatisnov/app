# Application & Auth.js -------------------------------------------------
# Public URL of the app (no trailing slash). Used in emails, guest links,
# the login QR code, and to decide whether cookies should be "secure".
APP_URL=http://localhost:3000

# Auth.js session/JWT secret. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Trust the Host / X-Forwarded-* headers from a reverse proxy.
AUTH_TRUST_HOST=true

PORT=3000

# Database ----------------------------------------------------------------
# See the README on the checked-out database branch (d1sql / libsql /
# libsql-local) for the variables that branch expects (e.g. DATABASE_URL,
# TURSO_DATABASE_URL, TURSO_AUTH_TOKEN, ...).

# Bootstrap admin -----------------------------------------------------------
# Created (or re-synced) on every start if both are set.
ADMIN_EMAIL=admin@stenaletnak.cz
ADMIN_PASS=change-me

# Google OAuth (optional) --------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP / email (optional) --------------------------------------------------
# Without SMTP_HOST, mail sending is skipped and logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Stěna Letňák Tišnov <noreply@stenaletnak.cz>"

# GoPay (optional) ----------------------------------------------------------
# Environment variables take precedence over the values stored in
# Admin -> Settings.
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_SANDBOX=true
