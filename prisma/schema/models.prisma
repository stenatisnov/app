// Data model for Stěna Letňák Tišnov — climbing wall gate access app.
// Shared across all database variant branches; see docs/SPECIFIKACE.md.

enum Role {
  MEMBER
  STAFF
  ADMIN
  ROOT
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Unused since the mobile redesign replaced this per-user toggle with a
/// fixed bottom tab bar (see BottomTabBar.tsx). Column intentionally
/// retained, not dropped, to avoid a cross-branch migration (Prisma Migrate
/// for libsql/libsql-local, hand-written flat SQL for d1sql/stena-d1sql*)
/// for a purely cosmetic cleanup — safe to remove in a dedicated follow-up.
enum NavStyle {
  BUTTONS
  HAMBURGER
}

enum PaymentMethod {
  QR
  GOPAY
  MANUAL
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

enum PackageKind {
  CREDITS
  PERIOD
  /// A single flat-priced item that credits the buyer plus optional
  /// companions on confirmation — see PaymentOrder.familyCompanionIds.
  FAMILY
}

enum PeriodPreset {
  WEEK
  MONTH
  YEAR
  CUSTOM
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  name          String?
  phone         String?
  passwordHash  String?
  image         String?
  /// Required for new registrations (age-gates account creation); null for
  /// pre-existing accounts predating this field, which are treated as adults.
  birthDate     DateTime?
  role          Role       @default(MEMBER)
  status        UserStatus @default(PENDING)
  suspended     Boolean    @default(false)
  navStyle      NavStyle   @default(BUTTONS)
  credits       Int        @default(0)
  /// Set on every gate open; blocks re-opening until it elapses.
  cooldownUntil DateTime?
  personTypeId  String?
  personType    PersonType? @relation(fields: [personTypeId], references: [id])
  /// Set when this account registered through a ChildGroup's invite link (or
  /// was later assigned one by an admin). Otherwise functions exactly like a
  /// normal MEMBER — the only effect is openGateForUser refusing a
  /// self-service open (verifiedByStaffId absent); staff can still check
  /// this account in individually or via the group's batch lookup on
  /// Ověřit permanentku.
  childGroupId  String?
  childGroup    ChildGroup? @relation(fields: [childGroupId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts       Account[]
  sessions       Session[]
  groups         UserGroup[]
  paymentOrders  PaymentOrder[]
  creditLedger   CreditLedger[]
  auditLogs      AuditLog[]
  gateEntries    GateEntry[]
  passwordResets PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  accessPasses   UserAccessPass[]
  confirmedOrders PaymentOrder[] @relation("ConfirmedBy")
  dependents      Dependent[]
  logbookHandoffCodes LogbookHandoffCode[]
  childGroupLeaderOf  ChildGroupLeader[]

  @@index([childGroupId])
}

/// Admin-managed group of kids brought in together (e.g. by a school or
/// club) rather than registering individually. Members join via the
/// group's own persistent invite link (see `inviteToken`) and otherwise
/// behave like any MEMBER, except they can't self-open the gate — see the
/// `User.childGroupId` doc comment and `openGateForUser`.
model ChildGroup {
  id          String   @id @default(cuid())
  name        String
  /// Persistent, non-expiring join link token — regenerated (not rotated
  /// automatically) by an admin if it ever needs to be invalidated.
  inviteToken String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leaders ChildGroupLeader[]
  members User[]
}

/// Informational only — a leader has no extra permissions in the app, this
/// just records who runs the group for admins to see.
model ChildGroupLeader {
  childGroupId String
  userId       String
  childGroup   ChildGroup @relation(fields: [childGroupId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([childGroupId, userId])
}

/// A companion (typically a child) entered under a parent/guardian's own
/// login — no account or password of their own. The parent buys credits for
/// them (at the dependent's own PersonType pricing) and picks them alongside
/// themselves when opening the gate; ledger entries stay attributed to the
/// parent account with `dependentId` recording who the entry/purchase was
/// actually for.
model Dependent {
  id           String      @id @default(cuid())
  parentUserId String
  parent       User        @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  name         String
  personTypeId String?
  personType   PersonType? @relation(fields: [personTypeId], references: [id])
  credits      Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  creditLedger  CreditLedger[]
  paymentOrders PaymentOrder[]

  @@index([parentUserId])
}

/// NextAuth.js OAuth account link (Google).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// NextAuth.js database session (unused directly with the JWT strategy, but
/// required by the Prisma adapter schema contract).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires   DateTime
  createdAt DateTime @default(now())
}

/// Own table rather than reusing NextAuth's generic `VerificationToken`
/// (identifier+token, no userId) — that one is the adapter's contract for an
/// Email/magic-link provider this app doesn't use, and repurposing it would
/// risk colliding with NextAuth's own assumptions if one is ever added.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires   DateTime
  createdAt DateTime @default(now())
}

/// One-time code for handing an already-authenticated user off to the
/// separate Logbook app (its own database, no login of its own). Created by
/// `/logbook`, consumed (deleted) by the server-to-server exchange the
/// Logbook backend makes at `/api/logbook/exchange` — see `src/lib/logbook.ts`.
model LogbookHandoffCode {
  code      String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// Access group. A user may belong to several; the gate opens if any group
/// has an active time window right now.
model Group {
  id        String        @id @default(cuid())
  name      String
  /// Assigned to new registrations automatically.
  isDefault Boolean       @default(false)
  /// Overrides `windows` — always open.
  is24_7    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  windows   GroupWindow[]
  members   UserGroup[]
}

model GroupWindow {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// JS `Date#getDay()` convention: 0 = Sunday … 6 = Saturday.
  dayOfWeek Int
  /// Minutes since local midnight (Europe/Prague).
  fromMin Int
  toMin   Int

  @@index([groupId, dayOfWeek])
}

model UserGroup {
  userId  String
  groupId String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

/// Category of member (e.g. "Adult", "Child") — determines which packages
/// are offered and priced.
model PersonType {
  id               String         @id @default(cuid())
  name             String         @unique
  isDefault        Boolean        @default(false)
  /// When true, members can pick this category themselves (currently: when adding a companion in Doprovod). When false, only an admin can assign it, in Administrace → Uživatelé.
  visibleToUsers   Boolean        @default(true)
  /// Marks this category as "child" for a FAMILY package's companion picker
  /// (see PaymentOrder.familyCompanionIds) — a Dependent has no birth date,
  /// so this is the only age signal available for classifying companions.
  /// Unmarked categories count as adult. No other effect in the app.
  isChildCategory  Boolean        @default(false)
  /// Marks this category as the price list for minors (15-17). When a
  /// 15-17-year-old self-registers (registerAction/completeGoogleProfileAction
  /// in src/lib/actions/auth.ts), they're assigned the oldest category with
  /// this flag set instead of the default category. No other effect.
  isMinorCategory  Boolean        @default(false)
  /// Marks this category as the price list for seniors (60 and over). Same
  /// auto-assignment and one-category-at-a-time rule as isMinorCategory —
  /// registerAction/completeGoogleProfileAction assign it to registrants
  /// 60 and over instead of the default category.
  isSeniorCategory Boolean        @default(false)
  createdAt        DateTime       @default(now())
  users           User[]
  packages        PricePackage[]
  dependents      Dependent[]
}

model PricePackage {
  id           String        @id @default(cuid())
  personTypeId String
  personType   PersonType    @relation(fields: [personTypeId], references: [id], onDelete: Cascade)
  kind         PackageKind   @default(CREDITS)
  /// Number of credits granted; unused (0) for PERIOD packages.
  credits      Int           @default(0)
  priceCzk     Int
  periodPreset PeriodPreset?
  /// Absolute validity window, only meaningful for CUSTOM period packages.
  periodFrom   DateTime?
  periodTo     DateTime?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  paymentOrders PaymentOrder[]
  accessPasses  UserAccessPass[]
}

/// Grants unlimited gate opens between validFrom/validTo, independent of
/// the credit balance. Created when a PERIOD package payment is confirmed.
model UserAccessPass {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId      String?
  package        PricePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  paymentOrderId String?
  paymentOrder   PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  validFrom      DateTime
  validTo        DateTime
  label          String?
  createdAt      DateTime      @default(now())

  @@index([userId, validFrom, validTo])
}

model PaymentOrder {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Set when the parent bought this package for a dependent rather than
  /// themselves — confirmation then credits the Dependent, not the User.
  dependentId        String?
  dependent          Dependent?    @relation(fields: [dependentId], references: [id], onDelete: Cascade)
  packageId          String?
  package            PricePackage? @relation(fields: [packageId], references: [id])
  method             PaymentMethod
  status             PaymentStatus @default(PENDING)
  /// Credits to grant on confirmation (0 for PERIOD packages / manual notes).
  credits            Int
  /// Dependent ids to also credit on confirmation, for a FAMILY package —
  /// selected at purchase time, re-validated (ownership + adult/child caps)
  /// at confirmation time since a Dependent may change between the two.
  familyCompanionIds Json?
  /// Recipient + chosen package pairs for a unified "Platba" purchase — the
  /// buyer and/or any number of Doprovod, each buying any of their own
  /// active CREDITS packages in one combined order. recipientId is "self" or
  /// a Dependent id. Re-validated (ownership + package still active/CREDITS)
  /// and re-priced-for-crediting at confirmation, same spirit as
  /// familyCompanionIds.
  items              Json?
  amountCzk          Int
  variableSymbol     String?
  goPayPaymentId     String?
  note               String?
  confirmedAt        DateTime?
  confirmedById      String?
  confirmedBy        User?         @relation("ConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  userAccessPasses UserAccessPass[]

  @@index([userId, status])
}

/// Append-only audit trail of every credit change: purchase (+), gate open
/// (-1), manual admin adjustment (±), or rollback after a lock failure.
model CreditLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Set when this row is actually about a dependent's credits (gate entry
  /// or purchase on their behalf) rather than the parent's own — `userId`
  /// still points at the parent account so admin/audit views stay findable
  /// by the one real login involved.
  dependentId String?
  dependent   Dependent? @relation(fields: [dependentId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([dependentId, createdAt])
}

/// One-time or multi-use free entry token, created by an admin. Not tied to
/// a user account or the credit ledger.
model GuestPass {
  id        String   @id @default(cuid())
  token     String   @unique
  maxUses   Int      @default(1)
  usedCount Int      @default(0)
  validFrom DateTime
  validTo   DateTime
  label     String?
  createdBy String?
  createdAt DateTime @default(now())
}

/// Immutable log of every successful and failed action: gate opens, logins,
/// payments, admin changes. Exposed via the admin UI with CSV export.
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  success    Boolean
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestToken String?
  message    String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([userId, createdAt])
}

/// One real entry through the gate. Written alongside the `gate.open` audit
/// row, but deliberately a separate table: the log cleanup (LogCleanupSettings)
/// deletes `AuditLog` wholesale, which used to erase the entry statistics
/// history with it — the yearly chart lost everything past the retention
/// window. `GateEntry` has no cleanup and is meant to be kept indefinitely;
/// it is the statistics' source of truth. See `src/lib/gate-entry.ts`.
///
/// One row per entry (an entry with dependents is still a single row; the
/// dependents are recorded in `meta`, same shape as the audit's), and only
/// for members — guest passes (`guest.open`) are not entries in this sense.
model GateEntry {
  id                String   @id @default(cuid())
  /// Null only when the account was deleted (onDelete: SetNull) — the entry
  /// itself stays, so historical counts survive account removal.
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Set when a staff member checked this entry in (Ověřit permanentku),
  /// absent for a self-service open. No relation: staff accounts get deleted
  /// too and the entry shouldn't depend on one.
  verifiedByStaffId String?
  message           String?
  /// False for staff-verified entries, which record the entry without
  /// driving the lock.
  gateOpened        Boolean  @default(true)
  simulated         Boolean  @default(false)
  usedPass          Boolean  @default(false)
  usedAdmin         Boolean  @default(false)
  creditsUsed       Boolean  @default(false)
  /// Everything else the audit row carried (creditsLeft, dependents, …).
  meta              Json?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// How many gate entries one unmatched incoming bank transfer paid for, as
/// estimated from the price list at the moment the transfer was recorded —
/// see `src/lib/payment-entry-estimate.ts`.
///
/// Deliberately its own table, for the same reason as `GateEntry`: the log
/// cleanup (LogCleanupSettings) deletes `AuditLog` wholesale by age, and the
/// estimate used to be derived from the transfer's `payment.fio.unmatched`
/// audit row — so cleaning the log quietly erased it from the statistics.
/// This table has no cleanup and is meant to be kept indefinitely.
///
/// Deliberately holds no personal data. The transfer's Fio id is kept only so
/// that re-seeing the same transfer can't record it twice; the payer's name,
/// their message and the variable symbol are never stored, and neither is any
/// breakdown by person type.
///
/// One row per *transfer*, not per entry (an amount paying for six entries is
/// a single row). `entries` is frozen at recording time rather than
/// re-derived from the current catalogue: the price list changes, and a
/// transfer from last season must keep the estimate it was given then.
model EstimatedEntry {
  id         String   @id @default(cuid())
  /// Fio's `idPohyb` for the transfer — makes recording (and the backfill)
  /// idempotent.
  fioIdPohyb String   @unique
  amountCzk  Int
  /// Entries the amount paid for, fewest-entries estimate. 0 means the
  /// transfer was seen and explained no entries at all (a rental, a donation).
  entries    Int
  /// The poll instant that learned about the transfer; Fio supplies only a
  /// calendar date, so this is the only time-of-day the estimate can carry.
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Generic admin-editable key/value settings (lock adapter, QR bank
/// account, GoPay credentials) stored as JSON.
model AppSetting {
  key   String @id
  value Json
}
