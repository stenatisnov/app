  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "prisma generate && react-router build",
    "lint": "eslint .",
    "typecheck": "wrangler types && react-router typegen && tsc --noEmit",
    "cf:build": "react-router build",
    "cf:preview": "react-router build && vite preview",
    "cf:deploy": "react-router build && wrangler deploy",
    "cf-typegen": "wrangler types && react-router typegen",
    "db:migrate": "prisma migrate dev",
    "db:migrate:local": "wrangler d1 migrations apply stena-tisnov-db-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply stena-tisnov-db-dev --remote",
    "db:deploy": "npm run db:migrate:local",
    "db:seed": "node scripts/seed-d1.mjs",
    "db:seed:remote": "node scripts/seed-d1.mjs --remote",
    "db:studio": "prisma studio"
  },
  "dependencies": {
