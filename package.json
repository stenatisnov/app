    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "i18next": "^24.2.2",
    "i18next-icu": "^2.4.4",
    "intl-messageformat": "^11.2.13",
    "isbot": "^5.1.22",
    "js-yaml": "^5.2.3",
    "jsqr": "^1.4.0",
